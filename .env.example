# ── Blackbox environment template ──────────────────────────────────────────
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — it must NEVER be committed. This template has no secrets.

# ── CockroachDB ─────────────────────────────────────────────────────────────
# Connection string from the CockroachDB Cloud Console → "Connect".
DATABASE_URL=postgresql://<user>:<password>@<host>:26257/blackbox?sslmode=verify-full

# CockroachDB Managed MCP Server (read-only introspection for the agent).
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_API_KEY=

# ── AWS / Amazon Bedrock ────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Reasoning model (Claude on Bedrock) and embedding model (Titan v2 = 1024 dims).
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── ccloud CLI (control plane) ──────────────────────────────────────────────
CC_API_KEY=
